    <string name="notflix_whats_new_title">What\'s new in Notflix</string>
    <string name="notflix_whats_new_version">Version %1$s</string>
    <string name="notflix_whats_new_ack">Got it</string>
    <string name="notflix_whats_new_about_title">What\'s new in this version</string>
    <string name="notflix_whats_new_about_subtitle">See the changes in version %1$s</string>
    <string-array name="notflix_whats_new_items">
        <item>Choose the card size: small, medium or large.</item>
        <item>Choose how fast cards open, and their buttons are easier to spot.</item>
        <item>Cards also open and play trailers inside collections.</item>
        <item>Ratings show whether they come from IMDb or TMDB.</item>
        <item>Autoplay by language: pick several, put them in order and choose whether quality or language comes first.</item>
        <item>Titles and descriptions in the app\'s language (with a TMDB key).</item>
        <item>Notflix is translated into every app language.</item>
        <item>Cleaner settings: choices open as lists, and options that don\'t affect Notflix are hidden.</item>
        <item>KIDS profiles get their own Home with cartoons and family titles (needs a TMDB key).</item>
        <item>Simkl can now be connected.</item>
        <item>Trakt: connect with just a code, no setup needed.</item>
    </string-array>
